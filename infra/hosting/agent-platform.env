# Non-secret config for agent-platform.service (secrets live in secrets.env, root 0600).
DATABASE_URL=postgresql:///agentplat?host=/var/run/postgresql&user=agentplat
# <host-ip>: this node's Tailscale IPv4 (the backend binds only there).
OWN_HOST=<host-ip>
OWN_PORT=43220
OWN_AUTH_FILE=/var/lib/agentplat/own/auth.json
OWN_WEB_DIST=/opt/agent-platform/web
PI_HOST_DIR=/var/lib/agentplat/host-control
HARNESS_MODE=pi
PI_PROVIDER=anthropic
PI_MODEL=claude-opus-5-5
PI_THINKING_LEVEL=medium
SANDBOX_PROVIDER=nomad-kata
NOMAD_ADDR=http://127.0.0.1:4646
NOMAD_BIN=/usr/local/bin/nomad
EGRESS_POLICY_DIR=/run/sandbox-egress/policies
EGRESS_CA_FILE=/var/lib/sandbox-egress/guest-ca.pem
# Accounts: Better Auth email/password sessions (BETTER_AUTH_SECRET, 32+ random chars, goes in
# secrets.env, e.g. `openssl rand -base64 48`). AUTH_MODE=tailnet (every request on the tailnet
# acts as TAILNET_OWNER, no sign-in) is only for a single-user node with tight Tailscale ACLs.
AUTH_MODE=better-auth
BETTER_AUTH_URL=https://<service>.<tailnet>.ts.net
# Comma-separated; these accounts get the admin role.
ADMIN_EMAILS=<admin-email>
# Off by default: set true only while creating accounts, then back to false.
SIGNUP_ENABLED=false
# Per-sandbox sizing (Nomad reservation; Kata guest = default_memory 512 MiB + this; cpu_hard_limit kept)
SANDBOX_MEMORY_MB=2048
SANDBOX_CPU_MHZ=4000
SANDBOX_DOCKER_TMPFS_MB=1024
# Stop a conversation sandbox after this long with no prompts/tool calls (15m, 30s, off)
SANDBOX_IDLE_TIMEOUT=15m
EGRESS_DEFAULT_RULES_FILE=/etc/agent-platform/egress-default-rules.json
# GitHub App reads of private repositories (infra/sandbox-kit/egress/GITHUB.md): comma-separated
# owner ids (Better Auth user ids). Empty: nobody; public repositories still clone anonymously.
GITHUB_APP_OWNERS=
# Workspace persistence: snapshot /workspace + inner Docker volumes to S3 on idle stop, restore
# on next start (SeaweedFS via linguini-s3.service; keys S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY in
# secrets.env). Anything other than "s3" = stop without saving.
SANDBOX_PERSISTENCE=s3
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=linguini-sandboxes
# Preview ports: /preview/<conversationId>/<port>/ on this origin forwards to shared sandbox ports.
PREVIEW_PUBLIC_ORIGIN=https://<service>.<tailnet>.ts.net
# Visual replies (html_preview / html_render): the render worker's socket (linguini-render.service,
# installed by 50-render-worker.sh). Unset: the tools answer "not configured".
RENDER_SOCKET=/run/linguini-render/render.sock
# Per-user storage for published pages (MiB), render concurrency (node-wide and per user).
RENDER_QUOTA_MB=200
RENDER_CONCURRENCY=2
RENDER_PER_USER_CONCURRENCY=1

# Pinned versions for the sandbox kit. Every value was checked on 2026-10-11 (ET) against the
# upstream release or package index named next to it. Change a pin only together with its
# checksum or digest, and rerun the guest scripts from 10- onward.

# Lima (host). Template fields verified against lima-vm/lima v2.2.1 templates/default.yaml and
# pkg/driver/vz/vm_darwin.go (nested virt: macOS >= 15, IsNestedVirtualizationSupported()).
KIT_LIMA_VERSION=2.2.1
KIT_LIMA_INSTANCE=kata-dind

# Supported sandbox node: Ubuntu 24.04 (noble) or 26.04 (resolute) on x86_64 (amd64) or aarch64
# (arm64), with KVM. KIT_UBUNTU lists the supported VERSION_ID:codename pairs.
KIT_UBUNTU="24.04:noble 26.04:resolute"
# linux/lib.sh sets KIT_ARCH=amd64|arm64 and picks the per-arch pins below.

# Docker Engine from download.docker.com (ubuntu <codename> stable). Pins are the upstream
# epoch:version-revision; linux/lib.sh (kit_docker_pins) appends Docker's per-release suffix
# "~ubuntu.<VERSION_ID>~<codename>". All four versions were checked in the binary-amd64 and
# binary-arm64 Packages indexes of both noble (2026-10-11) and resolute (2026-10-12): Docker
# publishes resolute, so 26.04 uses the same upstream versions, no fallback repo.
# docker-ce 29.8.2 Depends: containerd.io (>= 2.1.5). 29.9.0 existed but was two days old.
KIT_DOCKER_VERSION=5:29.8.2-1
KIT_CONTAINERD_VERSION=2.3.6-1
KIT_BUILDX_VERSION=0.38.0-1
KIT_COMPOSE_VERSION=5.6.0-1
# Docker's apt signing key fingerprint, as published in Docker's install docs.
KIT_DOCKER_GPG_FPR=9DC858229FC7DD38854AE2D88D81803C0EBFCD88

# Kata Containers 4.2.0 (released 2026-09-15). The kata-static archive ships runtime-rs (the
# default since 4.0.0), QEMU, guest kernel 6.18.35 and the image. Digest from the GitHub
# release asset metadata. Both archives were downloaded on the box and sha256-verified against
# it (amd64: 996,647,537 bytes; arm64: 653,631,272 bytes); file paths below exist in both.
KIT_KATA_VERSION=4.2.0
KIT_KATA_SHA256_amd64=b828904fa3f1e49ddd7dc799c72cb1503cd1e772d354c3987c8d4189b2a623a8
KIT_KATA_SHA256_arm64=5dd4e9f2d5ea9e6bdfa2f476b3315335b58252366fcda2775a3094fc8fec376b
KIT_KATA_SHIM=/opt/kata/runtime-rs/bin/containerd-shim-kata-v2
KIT_KATA_CONFIG=/opt/kata/share/defaults/kata-containers/runtime-rs/configuration-qemu-runtime-rs.toml
# Diagnostic alternative only (runtime-rs built-in VMM), registered as runtime "kata-db" for when
# QEMU fails under nested virtualization. Not allowed in Nomad.
KIT_KATA_CONFIG_DB=/opt/kata/share/defaults/kata-containers/runtime-rs/configuration-dragonball.toml

# Nomad 2.0.7 (released 2026-09-18), linux zips; sha256 from releases.hashicorp.com
# nomad_2.0.7_SHA256SUMS. The amd64 zip was also downloaded and verified on the box.
KIT_NOMAD_VERSION=2.0.7
KIT_NOMAD_SHA256_amd64=4c9b8a0850d6fd9caadbbab09b3e6fdf8b77aa777729543c70c61b85acca68c1
KIT_NOMAD_SHA256_arm64=19708097585efe0d60234f300b62892fa776ff93ca6ba5fb918360cbd118b71e

# Images, pinned by multi-arch index digest (Docker Hub, 2026-10-11). docker.io is the only
# approved registry for this kit.
KIT_DIND_IMAGE=docker.io/library/docker:29.8.2-dind@sha256:1e08cdb63405ca788aea94ef35b792d1e299607c667d33d7bcbcae1fd2611ced
KIT_ALPINE_IMAGE=docker.io/library/alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
KIT_BUSYBOX_IMAGE=docker.io/library/busybox:1.37@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e

# Sandbox sizing from handoff section 11: one Kata guest 4 vCPU / 8 GiB. The node needs that
# plus headroom for the service, proxy, Docker and Nomad (linux/00-preflight.sh checks it).
# A Kata VM's RAM is its base memory (default_memory in the runtime-rs QEMU config, 2048 MiB in
# Kata 4.2.0) plus the container limit hot-added, so one full sandbox needs ~10 GiB of guest RAM.
KIT_KATA_VM_BASE_MB=2048
KIT_NODE_RESERVE_MB=2048
KIT_SANDBOX_CPUS=4
KIT_SANDBOX_MEMORY_MB=8192
KIT_SANDBOX_PIDS=4096
# Inner Docker storage when the probe shows the rootfs cannot back it (see 40-inner-docker.sh).
KIT_INNER_TMPFS_MB=4096
# Capabilities granted to the inner dockerd. They apply inside the Kata guest kernel, not to the
# node kernel; see linux/40-inner-docker.sh for why each is needed and why not --privileged.
# SYS_PTRACE: dockerd opens /proc/<pid>/ns/net of each new container's first process, which
# needs ptrace-read access when that process runs as a non-root user (any image with USER);
# without it every non-root inner container fails ("bind-mount /proc/N/ns/net: permission
# denied"; found on the dev VM, step 40). It can only trace processes in this guest.
KIT_INNER_CAPS=SYS_ADMIN,NET_ADMIN,SYS_RESOURCE,NET_RAW,SYS_PTRACE

# Egress proxy (infra/sandbox-kit/egress): mitmproxy, installed from egress/requirements.lock
# (hash-locked, Python >= 3.12; binary wheels for every package exist for cp312..cp314, checked
# with --only-binary on 3.14.8) into a venv by linux/45-egress.sh: 3.12 on 24.04, 3.14 on 26.04.
KIT_MITMPROXY_VERSION=12.2.3

{
  "name": "t3-sandbox-prototype-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "own": "node --import tsx src/own-main.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-codemode": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@earendil-works/pi-telemetry": "1.5.2",
    "better-auth": "1.7.7",
    "pg": "8.16.3",
    "typebox": "1.3.27",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/ws": "8.18.2",
    "playwright-core": "1.64.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "ws": "$ws"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
